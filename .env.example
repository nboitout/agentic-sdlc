# Copy to .env.local for local development — never commit .env.local

# Admin dashboard (/admin) — shared password gate
ADMIN_PASSWORD=

# Visitor analytics + brochure lead capture — write path (Google Apps Script web app)
APPS_SCRIPT_URL=

# Visitor analytics + leads — read path (service account, Sheets API v4)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=          # or the raw PEM (fragile; code normalizes it)

# Optional exclusions (comma-separated reader_id cookies to hide from analytics)
EXCLUDED_READER_IDS=

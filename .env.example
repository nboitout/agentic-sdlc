# Copy to .env.local for local development — never commit .env.local

# Existing brochure lead-capture pipeline (see docs/google-sheets-brochure-webhook.md)
BROCHURE_SHEET_URL=

# Admin dashboard (/admin) — shared password gate
ADMIN_PASSWORD=

# Self-hosted visitor analytics — write path (Google Apps Script web app)
APPS_SCRIPT_URL=

# Self-hosted visitor analytics — read path (service account, Sheets API v4)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=          # or the raw PEM (fragile; code normalizes it)

# Optional: read-only access to the existing brochure-signup spreadsheet, so
# /admin/leads can display it. Bare id or full Sheet URL, either works. Share
# that spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer.
GOOGLE_BROCHURE_SHEET_ID=

# Optional exclusions (comma-separated reader_id cookies to hide from analytics)
EXCLUDED_READER_IDS=
